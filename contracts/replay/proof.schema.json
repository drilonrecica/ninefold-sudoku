{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninefold.recica.dev/schemas/replay/proof-v1.json",
  "title": "ReplayProof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proofVersion",
    "matchId",
    "finalEventNumber",
    "finalEventHash",
    "terminalAtMs",
    "keyId",
    "signature"
  ],
  "properties": {
    "proofVersion": { "const": 1 },
    "matchId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "finalEventNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "finalEventHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terminalAtMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "keyId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "signature": { "type": "string", "minLength": 86, "maxLength": 88 }
  }
}
