{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninefold.recica.dev/schemas/replay/replay-v1.json",
  "title": "ReplayDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "replayId",
    "matchId",
    "expiresAt",
    "clues",
    "rules",
    "participants",
    "events",
    "proof"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "replayId": { "$ref": "#/$defs/uuidv7" },
    "matchId": { "$ref": "#/$defs/uuidv7" },
    "expiresAt": { "$ref": "#/$defs/safePositiveInteger" },
    "clues": {
      "type": "string",
      "pattern": "^[0-9]{81}$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "difficulty",
        "errorPreset",
        "hintsEnabled",
        "autoRemoveNotes",
        "ruleVersion"
      ],
      "properties": {
        "mode": { "const": "Coop" },
        "difficulty": { "enum": ["Easy", "Medium", "Hard", "Expert"] },
        "errorPreset": { "enum": ["Casual", "Challenge", "Blind", "Clean"] },
        "hintsEnabled": { "type": "boolean" },
        "autoRemoveNotes": { "type": "boolean" },
        "ruleVersion": { "$ref": "#/$defs/safePositiveInteger" }
      }
    },
    "participants": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/uuidv7" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proofVersion",
          "eventNumber",
          "aggregateVersion",
          "publicEventType",
          "publicActorId",
          "occurredAtMs",
          "publicPayload",
          "privatePayloadDigest",
          "previousEventHash",
          "eventHash"
        ],
        "properties": {
          "proofVersion": { "const": 1 },
          "eventNumber": { "$ref": "#/$defs/safePositiveInteger" },
          "aggregateVersion": { "$ref": "#/$defs/safePositiveInteger" },
          "publicEventType": { "type": "string", "minLength": 1, "maxLength": 64 },
          "publicActorId": { "type": "string", "maxLength": 64 },
          "occurredAtMs": { "$ref": "#/$defs/safePositiveInteger" },
          "publicPayload": { "type": "object", "additionalProperties": true },
          "privatePayloadDigest": {
            "oneOf": [{ "const": "" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
          },
          "previousEventHash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          },
          "eventHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofVersion",
        "matchId",
        "finalEventNumber",
        "finalEventHash",
        "terminalAtMs",
        "keyId",
        "signature"
      ],
      "properties": {
        "proofVersion": { "const": 1 },
        "matchId": { "$ref": "#/$defs/uuidv7" },
        "finalEventNumber": { "$ref": "#/$defs/safePositiveInteger" },
        "finalEventHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "terminalAtMs": { "$ref": "#/$defs/safePositiveInteger" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "signature": { "type": "string", "minLength": 86, "maxLength": 88 }
      }
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
