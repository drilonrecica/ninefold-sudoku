{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninefold.recica.dev/schemas/realtime/client-message-v1.json",
  "title": "ClientMessage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "clientSequence", "target", "type", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "#/$defs/uuidv7" },
    "clientSequence": { "$ref": "#/$defs/safePositiveInteger" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "expectedVersion"],
      "properties": {
        "kind": { "enum": ["Room", "Match"] },
        "id": { "$ref": "#/$defs/uuidv7" },
        "expectedVersion": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "type": { "const": "sync.request" },
    "payload": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
