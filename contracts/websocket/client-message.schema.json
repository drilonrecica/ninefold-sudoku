{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninefold.recica.dev/schemas/realtime/client-message-v1.json",
  "title": "ClientMessage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "clientSequence", "type", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "#/$defs/uuidv7" },
    "clientSequence": { "$ref": "#/$defs/safePositiveInteger" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "expectedVersion"],
      "properties": {
        "kind": { "enum": ["Room", "Match"] },
        "id": { "$ref": "#/$defs/uuidv7" },
        "expectedVersion": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "type": {
      "enum": [
        "connection.initialize",
        "connection.request_control",
        "connection.heartbeat",
        "room.set_ready",
        "room.change_settings",
        "room.start_countdown",
        "room.cancel_countdown",
        "room.leave",
        "room.transfer_host",
        "room.prepare_rematch",
        "match.place_value",
        "match.erase_value",
        "match.add_note",
        "match.remove_note",
        "match.use_hint",
        "match.ping",
        "match.reaction",
        "match.focus_cell",
        "match.release_focus",
        "command.status"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roomCode": { "type": "string" },
        "lastRoomVersion": { "$ref": "#/$defs/safeInteger" },
        "lastMatchId": { "$ref": "#/$defs/uuidv7" },
        "lastMatchEventNumber": { "$ref": "#/$defs/safeInteger" },
        "ready": { "type": "boolean" },
        "displayName": { "type": "string" },
        "participantId": { "$ref": "#/$defs/uuidv7" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "difficulty": { "type": "string" },
            "errorPreset": { "type": "string" },
            "hintsEnabled": { "type": "boolean" },
            "autoRemoveNotes": { "type": "boolean" },
            "locked": { "type": "boolean" }
          }
        },
        "cell": { "type": "integer", "minimum": 0, "maximum": 80 },
        "value": { "type": "integer", "minimum": 1, "maximum": 9 },
        "digits": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 9 } },
        "level": { "enum": ["Nudge", "Reveal"] },
        "intent": { "type": "string" },
        "reaction": { "enum": ["agree", "nice_move"] },
        "targetCell": { "type": "integer", "minimum": 0, "maximum": 80 }
      }
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
