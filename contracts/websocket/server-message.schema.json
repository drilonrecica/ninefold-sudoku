{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninefold.recica.dev/schemas/realtime/server-message-v1.json",
  "title": "ServerMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventNumber",
    "aggregateVersion",
    "serverTimestamp",
    "type",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventNumber": { "$ref": "#/$defs/safePositiveInteger" },
    "aggregateVersion": { "$ref": "#/$defs/safePositiveInteger" },
    "serverTimestamp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": { "enum": ["ack", "rejection", "snapshot"] },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
