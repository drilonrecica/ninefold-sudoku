{
  "name": "ninefold-sudoku",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @ninefold/web build",
    "check": "pnpm --filter @ninefold/web check",
    "dev": "pnpm --filter @ninefold/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "lint": "pnpm --filter @ninefold/web lint",
    "test": "pnpm --filter @ninefold/web test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1"
  }
}
